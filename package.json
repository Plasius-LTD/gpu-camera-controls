{
  "name": "@plasius/gpu-camera-controls",
  "version": "0.1.3",
  "description": "Framework-agnostic multimodal camera controls for Plasius GPU camera rigs across browser, gamepad, and XR inputs.",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "legal/CLA.md",
    "legal/CORPORATE_CLA.md",
    "legal/INDIVIDUAL_CLA.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./xr": {
      "types": "./src/xr.d.ts",
      "import": "./dist/xr.js",
      "require": "./dist/xr.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "node --check src/index.js && node --check src/browser.js && node --check src/xr.js",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "npm run test:coverage",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test",
    "pack:check": "node scripts/release-changelog.mjs check CHANGELOG.md && npm run privacy:check && node scripts/verify-public-package.cjs",
    "prepublishOnly": "npm run build && npm run pack:check",
    "privacy:check": "node scripts/verify-private-artifacts.cjs",
    "test:privacy": "node --experimental-test-coverage --test-coverage-include=scripts/private-artifact-policy.cjs --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=60 --test tests/private-artifact-policy.test.cjs tests/schema-release.test.cjs"
  },
  "keywords": [
    "camera-controls",
    "touch-controls",
    "pointer-controls",
    "gamepad-controls",
    "xr-controls",
    "camera",
    "webgpu",
    "gpu",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "dependencies": {
    "@plasius/gpu-camera": "^0.1.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-camera-controls.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-camera-controls/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-camera-controls#readme",
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "brace-expansion": "5.0.12",
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  },
  "engines": {
    "node": ">=24"
  }
}
